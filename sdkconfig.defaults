#
# USB Host / OTG support
#
CONFIG_ESP_USB_OTG_SUPPORTED=y
CONFIG_USB_OTG_SUPPORTED=y
CONFIG_USB_HOST_ENABLED=y
CONFIG_USB_HOST_TASK_PRIORITY=5
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=256
# CONFIG_USB_HOST_HUBS_SUPPORTED=y

#
# Disable USB Device (biar nggak bentrok sama upload sketch via UART)
#
CONFIG_USB_DEVICE_ENABLED=n

#
# PSRAM (optional kalau DevKitC-1 lo ada PSRAM)
#
CONFIG_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_BOOT_INIT=y

#
# WiFi
#
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

#
# Log level (optional)
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y